{
  "name": "nexgen-dashcam",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev:mobile": "turbo run dev --filter=@nexgen/mobile",
    "dev:web": "turbo run dev --filter=@nexgen/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
